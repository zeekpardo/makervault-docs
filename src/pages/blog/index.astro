---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<MarketingLayout
  title="Blog — Maker Tips, Tools & File Organization"
  description="Articles for laser cutters, CNC, and 3D printing makers on file organization, workflow tips, and tool comparisons."
>
  <div class="container mx-auto px-4 pt-20 pb-24 max-w-3xl">
    <div class="mb-12">
      <small class="font-medium text-xs uppercase tracking-wider text-primary mb-3 block">From the maker</small>
      <h1 class="text-4xl lg:text-5xl font-medium">Blog</h1>
      <p class="mt-3 text-foreground/60 text-lg">
        Tips, tools, and honest takes on file organization for laser cutters, CNC, and 3D printing makers.
      </p>
    </div>

    <div class="flex flex-col gap-8">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group block rounded-2xl border bg-card p-6 lg:p-8 hover:border-primary/50 transition-colors"
        >
          <div class="flex items-center gap-2 text-xs text-foreground/40 mb-3">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.author && (
              <>
                <span>·</span>
                <span>{post.data.author}</span>
              </>
            )}
          </div>
          <h2 class="text-xl lg:text-2xl font-medium group-hover:text-primary transition-colors">
            {post.data.title}
          </h2>
          <p class="mt-2 text-foreground/60 text-sm lg:text-base leading-relaxed">
            {post.data.description}
          </p>
          <span class="mt-4 inline-flex items-center text-primary text-sm font-medium">
            Read article →
          </span>
        </a>
      ))}
    </div>
  </div>
</MarketingLayout>
