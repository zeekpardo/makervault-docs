---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<MarketingLayout title={post.data.title} description={post.data.description}>
  <article class="container mx-auto px-4 pt-20 pb-24 max-w-3xl">

    <header class="mb-10">
      <a href="/blog" class="inline-flex items-center text-sm text-foreground/50 hover:text-foreground transition-colors mb-6">
        ← Back to blog
      </a>
      <div class="flex items-center gap-2 text-xs text-foreground/40 mb-4">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.author && (
          <>
            <span>·</span>
            <span>By {post.data.author}</span>
          </>
        )}
      </div>
      <h1 class="text-3xl lg:text-4xl xl:text-5xl font-medium leading-tight">{post.data.title}</h1>
      <p class="mt-4 text-foreground/60 text-lg leading-relaxed">{post.data.description}</p>
    </header>

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <Content />
    </div>

    <div class="mt-16 rounded-3xl bg-primary/5 border border-primary/20 p-6 lg:p-8 text-center">
      <p class="text-sm font-medium text-primary uppercase tracking-wider mb-2">Early Access — 100 spots</p>
      <h2 class="text-2xl font-medium mb-2">Ready to get your maker library under control?</h2>
      <p class="text-foreground/60 mb-6">MakerVault is purpose-built for your file formats. No cloud. No subscription.</p>
      <a
        href="/waitlist"
        class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 font-medium text-primary-foreground text-sm hover:bg-primary/90 transition-colors"
      >
        Claim Your Early Access Spot →
      </a>
    </div>

  </article>
</MarketingLayout>
