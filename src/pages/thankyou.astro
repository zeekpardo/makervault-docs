---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="You're on the list!" description="Thanks for signing up for MakerVault early access.">
  <div class="container mx-auto px-4 max-w-2xl pt-32 pb-24 text-center">
    <div class="inline-flex items-center justify-center rounded-full bg-primary/10 p-4 mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary size-8">
        <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><path d="m16 19 2 2 4-4"/>
      </svg>
    </div>
    <h1 class="text-4xl font-medium mb-3">You're on the list!</h1>
    <p class="text-foreground/60 text-lg max-w-md mx-auto">
      We'll reach out the moment MakerVault is ready to launch. Keep an eye on your inbox.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 font-medium text-primary-foreground text-sm hover:bg-primary/90 transition-colors"
    >
      Back to home
    </a>
  </div>
</MarketingLayout>
