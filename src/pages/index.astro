---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/Hero';
import ProblemSection from '../components/ProblemSection';
import Features from '../components/Features';
import Newsletter from '../components/Newsletter';
import BuilderSection from '../components/BuilderSection';
import FaqSection from '../components/FaqSection';


const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "MakerVault",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "macOS, Windows",
  "description": "MakerVault is a local-first file organizer for makers. Search, tag, and preview laser cutter, CNC, and 3D printing design files instantly — no cloud, no subscription.",
  "url": "https://makervaultapp.com",
  "image": "https://makervaultapp.com/og-image.png",
  "featureList": [
    "Full-text search across filenames, tags, notes, and file contents",
    "Deep search inside LightBurn and xTool Creative Space files",
    "Spacebar quick preview for 25+ file types including SVG, DXF, STL, LightBurn, xTool, PDF, and fonts",
    "LightBurn deep read — cut settings, layer info, font names, text elements",
    "xTool Creative Space deep read — processing parameters, layer settings, material info",
    "Hierarchical tagging with nested tags up to 3 levels deep",
    "Bulk tagging, source assignment, and machine profile assignment",
    "ZIP bundle browser — preview files inside ZIP without extracting",
    "Real-time file watching with automatic indexing",
    "Duplicate file detection via content hashing",
    "Source tracking for file origins",
    "Machine profile tracking with types and manufacturers",
    "Material tracking with category, brand, and supplier management",
    "Project build tracking — log machine, material, cuts, and finished-work photos",
    "Local-first — no cloud, no account, works fully offline"
  ]
};
---

<MarketingLayout>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero client:load />
  <ProblemSection />
  <Features />
  <BuilderSection />
  <Newsletter client:load />
  <FaqSection client:visible />
</MarketingLayout>
